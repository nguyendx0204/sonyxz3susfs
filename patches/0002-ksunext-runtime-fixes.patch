 	"\n"
 
 	"on nonencrypted\n"
@@ -57,6 +60,7 @@ static const char KERNEL_SU_RC[] =
 	"\n"
 
 	"on property:sys.boot_completed=1\n"
+	"    write /dev/kmsg KernelSU_RC_BOOT_COMPLETED_REACHED\n"
 	"    exec u:r:" KERNEL_SU_DOMAIN ":s0 root -- " KSUD_PATH " boot-completed\n"
 	"\n"
 
@@ -426,11 +430,14 @@ static bool is_init_rc(struct file *fp)
         return false;
     }
 
