diff --git a/kernel/runtime/ksud_integration.c b/kernel/runtime/ksud_integration.c
index b05cc998..3f1b1d23 100644
--- a/kernel/runtime/ksud_integration.c
+++ b/kernel/runtime/ksud_integration.c
@@ -43,9 +43,12 @@ static const char KERNEL_SU_RC[] =
 	"\n"
 
 	"on post-fs-data\n"
+	"    write /dev/kmsg KernelSU_RC_POST_FS_DATA_REACHED\n"
 	"    start logd\n"
 	// We should wait for the post-fs-data finish
 	"    exec u:r:" KERNEL_SU_DOMAIN ":s0 root -- " KSUD_PATH " post-fs-data\n"
+	"    write /dev/kmsg KernelSU_RC_SERVICES_REACHED\n"
